{
  "name": "react-rrule-form",
  "version": "0.1.1",
  "description": "A recurrence-rule (RFC 5545 RRULE) form component for React. Tailwind-styled by default, restylable down to every element, zero runtime dependencies.",
  "keywords": [
    "react",
    "rrule",
    "recurrence",
    "rfc5545",
    "icalendar",
    "schedule",
    "recurring",
    "form",
    "component",
    "tailwind"
  ],
  "license": "MIT",
  "author": "Erwan Joly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erwan-joly/react-rrule-form.git"
  },
  "homepage": "https://erwan-joly.github.io/react-rrule-form/",
  "bugs": {
    "url": "https://github.com/erwan-joly/react-rrule-form/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsup && tailwindcss -i src/styles/base.css -o dist/styles.css --minify",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "rrule": "^2.8.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.15.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
